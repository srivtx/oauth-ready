# Default model provider: OpenCode Zen (https://opencode.ai/zen), DeepSeek V4.1 Flash (~2–5¢ per guide)
OPENCODE_API_KEY=

# Optional: override the OpenCode model chains (comma-separated, tried in order)
# OPENCODE_MODELS_SMART=deepseek-v4.1-flash,qwen3.8-flash
# OPENCODE_MODELS_FAST=deepseek-v4.1-flash,qwen3.8-flash

# Optional fallback: Gemini free tier (small daily quota) from https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Optional: higher rate limits for the Jina page reader (works without a key)
# JINA_API_KEY=

# Optional (deployment): persist generated guides in Vercel Blob.
# Without it, guides are saved to ./data/generated (local dev only).
# BLOB_READ_WRITE_TOKEN=

# Visitors can also bring their own key for any allow-listed provider via ⚙ in the UI.
# Their key is sent per request only and is never stored server-side.
